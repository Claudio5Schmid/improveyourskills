# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored; NEVER commit real values. The same values also go
# into Vercel → Settings → Environment Variables (see docs/VERCEL.md).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — from your project: Settings → API.
# Public, safe in the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — full server-side access. Only used in server code, never shipped to
# the browser, never committed. From Settings → API → "service_role".
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL (for later phases: OG tags, sitemap, canonical links).
# For the Vercel preview use the *.vercel.app URL; in production the real domain.
NEXT_PUBLIC_SITE_URL=

# ─── Only needed locally to apply migrations (never used by the app, never in
#     Vercel). Fill these in .env.local so the CLI can link + push to your
#     project. All three are SECRET-ish — keep them out of chat and git. ───────
# Project ref: the sub-domain of your project URL, e.g. abcd1234 from
#   https://abcd1234.supabase.co
SUPABASE_PROJECT_REF=
# The database password you set when creating the project.
SUPABASE_DB_PASSWORD=
# A personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Resend — sends the contact-form notification + auto-reply (Phase 5).
# API key from https://resend.com/api-keys.
RESEND_API_KEY=
# Sender address for outgoing mail, e.g. "Improve your skills <kontakt@improveyourskills.ch>".
# Until your domain is verified with Resend, leave empty — the code falls back
# to Resend's own test sender automatically (docs/RESEND.md walks through this).
RESEND_FROM_EMAIL=
# Where the contact-form notification email goes, e.g. info@improveyourskills.ch.
# No fallback if this is unset — the notification is skipped and logged as an
# error instead of silently going to a hardcoded address.
CONTACT_TO_EMAIL=

# Cloudflare Turnstile — spam protection on the contact form (Phase 5).
# Both keys from https://dash.cloudflare.com/?to=/:account/turnstile.
# Site key is public (safe in the browser); secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Random string that salts the visitor IP hash stored with each contact
# message — we never store a raw IP address. Generate once with:
#   openssl rand -hex 32
CONTACT_IP_HASH_SALT=

# Protects the daily Supabase keep-alive cron (/api/cron/keep-alive) so only
# Vercel can trigger it. Vercel sends it automatically as
# "Authorization: Bearer <this value>" once it is set in the project.
# Set it in VERCEL, not just locally — without it the cron refuses to run and
# the Supabase project would eventually pause. Generate once with:
#   openssl rand -hex 32
CRON_SECRET=
