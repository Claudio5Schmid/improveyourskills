# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored; NEVER commit real values. The same values also go
# into Vercel → Settings → Environment Variables (see docs/VERCEL.md).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — from your project: Settings → API.
# Public, safe in the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — full server-side access. Only used in server code, never shipped to
# the browser, never committed. From Settings → API → "service_role".
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL (for later phases: OG tags, sitemap, canonical links).
# For the Vercel preview use the *.vercel.app URL; in production the real domain.
NEXT_PUBLIC_SITE_URL=
